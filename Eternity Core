        self.e = mp.e
        self.pi = mp.pi
        
        # Scaling pairs from the primary archive
        self.pair1_num = mp.mpf('1111')
        self.pair1_den = mp.mpf('2222')
        
        self.pair2_num = mp.mpf('1234')
        self.pair2_den = mp.mpf('2468')

