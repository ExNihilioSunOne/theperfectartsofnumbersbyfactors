import mpmath as mp
import cmath

# Set internal calculations to 150 digits of precision
mp.mp.dps = 150

class GlobalIntegrationEngine:
    def __init__(self, spatial_frequency=1.22674201072):
        self.target_pi = mp.pi
        self.anchor_22_7 = mp.mpf('22') / mp.mpf('7')
        self.anchor_87_13 = mp.mpf('87') / mp.mpf('13')
        self.omega = mp.mpf(str(spatial_frequency)) # Spatial rotation constant

    def compute_integrated_system(self, total_steps=4):
        """Runs the unified error, complex phase, and dynamic AGM loop."""
        current_approx = self.anchor_22_7
        system_ledger = []
        
        # Complex trajectory starting coordinates
        complex_x = mp.mpf('0')
        complex_y = mp.mpf('0')
        
        print("=============================================================================")
        print("        GLOBAL INTEGRATION SYSTEM RUN: DISCRETE TO CONTINUOUS BRIDGE        ")
        print("=============================================================================\n")
        
        for n in range(1, total_steps + 1):
            # 1. Evaluate discrete baseline error (Pillar I)
            residual_error = self.target_pi - current_approx
            abs_error = mp.abs(residual_error)
            
            if abs_error == 0:
                print(f" [CLOSURE] Absolute convergence reached at step {n}.")
                break
                
            d_n = mp.floor(1 / abs_error)
            sign = mp.mpf('-1') if n % 2 != 0 else mp.mpf('1')
            correction_term = sign / d_n
            
            # 2. Map trajectory into the complex spatial plane
            # Vector angle rotation: theta = n * omega
            theta = n * self.omega
            complex_x += correction_term * mp.cos(theta)
            complex_y += correction_term * mp.sin(theta)
            spatial_radius = mp.sqrt(complex_x**2 + complex_y**2)
            
            # 3. Inject error metrics to calibrate AGM boundaries (Pillar II)
            calibrated_a0 = self.anchor_87_13 * (1 + abs_error)
            calibrated_b0 = (self.anchor_22_7 - self.anchor_87_13) / (1 + abs_error)
            
            # Run one inline refinement step of the coupled AGM field
            agm_a1 = (calibrated_a0 + calibrated_b0) / 2
            agm_b1 = mp.sqrt(calibrated_a0 * calibrated_b0)
            coupled_stabilizer = (4 * agm_a1 * agm_b1) / ((agm_a1 + agm_b1)**2)
            
            # Update approximation tracking for the next iteration step
            current_approx += correction_term
            
            # Archive all metrics for the system record
            system_ledger.append({
                "step": n,
                "denominator_d_n": int(d_n),
                "complex_coordinates": (mp.nstr(complex_x, 15), mp.nstr(complex_y, 15)),
                "spatial_radius": mp.nstr(spatial_radius, 15),
                "coupled_agm_stabilizer": mp.nstr(coupled_stabilizer, 45)
            })
            
        return system_ledger

    def display_system_metrics(self, ledger):
        """Formats and displays the integrated metrics to verify grid stability."""
        for entry in ledger:
            print(f" 🌐 LAYER STEP {entry['step']}:")
            print(f"   • Structural Integer Node (d_n):  {entry['denominator_d_n']}")
            print(f"   • Complex Plane Coordinate Vector: ({entry['complex_coordinates'][0]} + i*{entry['complex_coordinates'][1]})")
            print(f"   • Convergent Radial Step Distance: {entry['spatial_radius']}")
            print(f"   • Coupled Field AGM Stabilizer:    {entry['coupled_agm_stabilizer']}...")
            print("   " + "-"*72)
            
        print("\n=============================================================================")
        print(" STATUS: INTEGRATED TRAJECTORY APPLIED | MATRIX LOCK OPERATIONAL | SA TU     ")
        print("=============================================================================")

